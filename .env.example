# Claude API 凭据（必填）
ANTHROPIC_API_KEY=sk-ant-xxx

# 可选：模型（默认 claude-opus-5）
# ANTHROPIC_MODEL=claude-opus-5

# 可选：Claude API 代理。如果本机是 TUN 透明代理则不需要设置；
# 如果是系统/手动代理，填代理地址：
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选：视觉模型（图片理解）。主模型无视觉能力时自动启用
# 注册智谱开放平台 https://open.bigmodel.cn/ 获取 API Key（GLM-4V-Flash 永久免费）
# VISION_API_KEY=你的智谱key.你的secret
# VISION_MODEL=glm-4v-flash
